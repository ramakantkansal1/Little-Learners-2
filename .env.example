# Happy Little Learners - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials

# ===========================================
# Application
# ===========================================
APP_NAME="Happy Little Learners"
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Database (MySQL 8.x)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=happy_little_learners
DB_USER=hll_user
DB_PASSWORD=your-secure-app-password
DB_CHARSET=utf8mb4

# MySQL Root Password (separate from application user)
MYSQL_ROOT_PASSWORD=your-secure-root-password

# Database URL for SQLAlchemy (alternative to individual params)
# DATABASE_URL=mysql+asyncmy://hll_user:your-secure-app-password@localhost:3306/happy_little_learners?charset=utf8mb4

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===========================================
# Email (Optional - for production)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# SMTP_FROM_EMAIL=noreply@happylittlelearners.in
# SMTP_FROM_NAME="Happy Little Learners"
# EMAIL_VERIFICATION_ENABLED=false

# ===========================================
# SMS / OTP (Optional - for production)
# ===========================================
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# OTP_ENABLED=false

# ===========================================
# File Storage (Optional - for production)
# ===========================================
# STORAGE_PROVIDER=local
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=10
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml
# ALLOWED_AUDIO_TYPES=audio/mpeg,audio/ogg,audio/wav

# ===========================================
# Speech / TTS (Optional)
# ===========================================
# TTS_PROVIDER=local
# TTS_API_KEY=your-api-key
# TTS_VOICE_DEFAULT=default

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_MINUTES=1

# ===========================================
# Frontend (Vite)
# ===========================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Happy Little Learners"